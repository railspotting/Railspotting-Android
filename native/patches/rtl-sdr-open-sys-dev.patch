+/* Open the dongle behind a USB file descriptor (Android, where an app may not list devices
+ * and gets a descriptor for the one the user allowed). The descriptor stays the caller's:
+ * rtlsdr_close does not close it. Added for the RailSpotting Android app. */
+int rtlsdr_open_sys_dev(rtlsdr_dev_t **out_dev, intptr_t sys_dev)
+{
+	int r;
+	rtlsdr_dev_t *dev = NULL;
+
+	dev = malloc(sizeof(rtlsdr_dev_t));
+	if (NULL == dev)
+		return -ENOMEM;
+
+	memset(dev, 0, sizeof(rtlsdr_dev_t));
+	memcpy(dev->fir, fir_default, sizeof(fir_default));
+
+	/* no device list: only the descriptor we are given */
+	libusb_set_option(NULL, LIBUSB_OPTION_NO_DEVICE_DISCOVERY);
+	r = libusb_init(&dev->ctx);
+	if (r < 0) {
+		free(dev);
+		return -1;
+	}
+
+	dev->dev_lost = 1;
+
+	r = libusb_wrap_sys_device(dev->ctx, sys_dev, &dev->devh);
+	if (r < 0) {
+		fprintf(stderr, "usb_wrap_sys_device error %d\n", r);
+		goto err;
+	}
+
+	r = rtlsdr_open_finish(dev);
+	if (r < 0)
+		goto err;
+
+	*out_dev = dev;
+
+	return 0;
+err:
+	if (dev->devh)
+		libusb_close(dev->devh);
+
+	if (dev->ctx)
+		libusb_exit(dev->ctx);
+
+	free(dev);
+
+	return r < 0 ? r : -1;
+}
